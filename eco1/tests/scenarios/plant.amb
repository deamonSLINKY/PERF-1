# ECO-1: the plant grows, fires, answers the weather
wav fern.wav
wait 4000
shot boot.png
wait 40000
expect playing 1
expect fires >10
shot fern.png
wavstop
tap EDIT
wait 1500
shot touch.png
# the weather page: a storm
tap SEQ
spin K1 60
spin K2 60
spin K3 60
wait 300
shot weather.png
wav storm.wav
wait 40000
expect drops >100
shot storm.png
wavstop
# night: the plant page, a short day
tap HOME
spin K2 -40
wait 20000
shot later.png
tap REC
wait 2000
expect frozen 1
shot frozen.png
tap REC
tap SEL
expect view 1
spin K2 3
spin K3 2
tap OCT-
wait 3000
expect par31 -1
expect par29 3
expect par30 3
shot stem.png
tap ENV
shot low.png
turn PRESET 3
wait 5000
expect piece 3
shot cactus.png
tap PLAY
wait 8000
expect playing 0
peakreset
wait 15000
expect peak_db_max -36
