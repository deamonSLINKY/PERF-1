# ECO-1's renders: the simulator's screens and lights (tools/site/mockups.py runs this). 'echo @name' then
# 'leds' names the lights that go with a shot. Made by hand once; the MIDI clock ticks near the end.
splash 3200
reboot
wait 900
shot splash.png
wait 1500
shot splash_eco.png
wait 1200
wait 9000
tap HOME
wait 400
shot plant.png
echo @plant
leds
tap SEL
wait 300
shot stem.png
echo @stem
leds
tap ENV
wait 300
shot low.png
echo @low
leds
tap ARP
wait 300
shot mid.png
tap LFO
wait 300
shot top.png
tap SEQ
wait 300
shot weather.png
echo @weather
leds
tap FX
wait 300
shot space.png
tap GLO
wait 300
shot setup.png
tap GLO
wait 300
shot midiout.png
echo @midiout
leds
tap HOME
press REC
wait 1200
shot help.png
release REC
wait 300
tap EDIT
wait 900
shot touch.png
echo @touch
leds
wait 3000
wait 7000
shot p_fern.png
echo @p_fern
leds
turn PRESET 1
wait 7000
shot p_orchid.png
echo @p_orchid
leds
turn PRESET 1
wait 7000
shot p_moss.png
echo @p_moss
leds
turn PRESET 1
wait 7000
shot p_cactus.png
echo @p_cactus
leds
turn PRESET 1
wait 7000
shot p_willow.png
echo @p_willow
leds
turn PRESET 1
wait 7000
shot p_lotus.png
echo @p_lotus
leds
turn PRESET 1
wait 7000
shot p_ivy.png
echo @p_ivy
leds
turn PRESET 1
wait 7000
shot p_bamboo.png
echo @p_bamboo
leds
turn PRESET -2
wait 300
spin K2 -100
wait 21000
shot night.png
echo @night
leds
turn PRESET -2
wait 300
tap SEQ
spin K1 80
spin K2 80
spin K3 80
wait 22000
tap HOME
wait 300
shot storm.png
echo @storm
leds
turn PRESET -3
wait 300
tap SEQ
spin K1 -100
tap HOME
spin K3 100
spin K2 -100
wait 335000
shot drought.png
turn PRESET 6
wait 300
tap SEQ
spin K1 100
tap HOME
spin K3 -100
wait 300
