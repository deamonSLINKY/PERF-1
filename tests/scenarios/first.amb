# a first look and listen: it plays from power-on; every page; half a minute of Hypnos
wav first.wav
wait 200
expect playing 1
expect pool 0x5AD
wait 6000
shot flow.png
expect pad_level >20
wait 30000
shot flow30.png
expect sixteenths >40
expect acidnotes >0
wavstop
expect peak_db_max -0.5
expect peak_db_min -30
# the buttons' pages: ENV the pad (again: its envelope, its LFO, the chords), LFO the drone (and its own two),
# ARP the acid (and its envelope, its line), SEQ the drums, GLO global
tap ENV
expect view 1
shot pad.png
tap ENV
expect view 2
shot pad_env.png
tap ENV
expect view 3
shot pad_lfo.png
tap ENV
expect view 4
shot chords.png
tap ENV
expect view 1
tap LFO
expect view 5
shot drone.png
tap LFO
tap LFO
expect view 7
shot drone_lfo.png
tap ARP
expect view 9
shot acid.png
tap ARP
tap ARP
expect view 11
shot acid_line.png
tap SEQ
expect view 18
shot drums.png
tap GLO
expect view 30
shot global.png
# SELECT: the pages in order, Noise, Space and the Master (compressor, limiter) among them
turn SELECT -1 100
expect view 29
shot mixer.png
turn SELECT -1 100
expect view 28
shot master.png
turn SELECT -1 100
expect view 27
shot reverb.png
turn SELECT -1 100
expect view 26
shot space.png
turn SELECT -21 100
expect view 5
shot noise.png
turn SELECT -9 100
expect view 0
tap HOME
