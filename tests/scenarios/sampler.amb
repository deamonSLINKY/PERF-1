# The sampler (the FX menu's fourth bank, the SELECT dial three times): the keys play the last stretch of the music, frozen while they are held.
seed 0
wait 4000
tap FX
wait 100
spin SELECT 1
wait 100
spin SELECT 1
wait 100
spin SELECT 1
wait 100
expect fxbank 3
key 13 down
wait 400
expect smp 1
shot sampler_held.png
key 20 down
wait 300
expect smp 2
key 13 up
key 20 up
wait 1500
expect smp 0