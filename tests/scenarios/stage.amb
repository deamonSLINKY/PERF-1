# The STAGE page (the last FX edit page but one): the key change, the screensaver (the visualizers take the screen after a minute's quiet while it plays),
# the key lights; any touch brings the page back.
seed 0
wait 3000
press SEL
tap FX
release SEL
wait 100
# (talk and wah come after the flanger now: two more turns to the same pages)
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
spin SELECT 1
wait 30
# (the Repeat page, 23, walks before the sweep since 0.14.10: one more turn)
spin SELECT 1
wait 100
expect fxpage 18
expect saver 0
expect lights 0
spin K2 1
wait 50
expect saver 1
spin K3 1
wait 50
expect lights 1
tap FX
wait 100
expect view 0
wait 62000
expect saveron 1
expect view 33
shot saver.png
tapkey 1
wait 200
expect saveron 0
expect view 0
