# The STAGE page (the last FX edit page but one): the key change, the screensaver (the visualizers take the screen after a minute's quiet while it plays),
# the key lights; any touch brings the page back.
seed 0
wait 3000
# (0.16.1) the key change on SETTINGS, the screensaver and the lights on SCREEN: the settings' walk, HOME held
press HOME
wait 800
release HOME
wait 100
turn SELECT 2
wait 100
expect fxpage 18
turn SELECT 6
wait 100
expect fxpage 31
expect saver 0
expect lights 0
spin K2 1
wait 50
expect saver 1
spin K3 1
wait 50
expect lights 1
tap FX
wait 100
expect view 0
wait 62000
expect saveron 1
expect view 36
shot saver.png
tapkey 1
wait 200
expect saveron 0
expect view 0
