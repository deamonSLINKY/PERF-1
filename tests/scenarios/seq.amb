# the drum sequencer: SEQ held opens it; the sixteen white keys (the lower row) are the lane's steps,
# lit where it hits, tapped to turn a hit on or off; OCT- / OCT+ the drum; it edits the pattern chosen;
# stored with its piece (Global, SAVE)
wait 500
expect pat 0
expect lane0 4369
press SEQ
wait 500
release SEQ
expect view 28
expect seqlane 0
# a kick on step 3: the third white key (A3, key 4)
tapkey 4
expect lane0 4373
# and off again, and on
tapkey 4
expect lane0 4369
tapkey 4
expect lane0 4373
# SEL and SELECT edit nothing here
tap SEL
expect lane0 4373
# the snare (OCT+): the thirteenth white key (D5, key 21), step 13
tap OCT+
expect seqlane 1
tapkey 21
expect lane1 4096
shot seq.png
# the black keys are not steps
tapkey 1
expect lane1 4096
# OCT- back to the kick, and round the other way to the perc
tap OCT-
expect seqlane 0
tap OCT-
expect seqlane 5
tap OCT+
tap OCT+
expect seqlane 1
# the lane's sound: its level, on KNOB 1
spin K1 -10
expect par52 50
# pattern 3 (KNOB 4): it waits for the bar, and the sequencer shows it
spin K4 2
expect par48 2
wait 20
expect patnext 2
wait 2500
expect pat 2
shot seq_p3.png
# SEQ tapped in the sequencer: back to Drums; SELECT from it goes on through the pages
expect view 28
turn SELECT 1 100
expect view 17
press SEQ
wait 500
release SEQ
expect view 28
tap SEQ
expect view 16
# a theme (Global, KNOB 2): the player's, written by itself once stopped
tap GLO
spin K2 2
expect theme 2
expect dirty 1
shot theme_ice.png
# the piece stored (SAVE on Global): its patterns, its lanes' sounds, its pattern chosen
tap SAVE
tap PLAY
wait 4000
expect dirty 0
expect store_writes >0
# power off and on: all of it kept
reboot
wait 300
expect theme 2
expect par48 2
expect pats0_0 4373
expect pats0_1 4096
expect par52 50
