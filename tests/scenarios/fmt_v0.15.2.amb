# The save formats (tools/format_fixture.sh): what release v0.15.2 saved (tests/format/v0.15.2/) loads in this build as it did when the fixture
# was made (tests/format/v0.15.2/state.txt; a line this build adds is fine, a line that changed is not).
seed 0
wait 500
loadobj 0 tests/format/v0.15.2/o0.bin
