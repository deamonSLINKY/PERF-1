# The look (Imp, the first theme: the header's coil and beat bar, the knob strip's tabs and large values), then its colour variations (Global K2).
# Screenshots only: look at them.
seed 0
wait 3000
expect theme 0
tap GLO
wait 300
shot imp_global.png
tap HOME
wait 600
shot imp_tempo.png
tap ENV
wait 600
shot imp_pad.png
tap LFO
wait 600
shot imp_drone.png
tap ARP
wait 600
shot imp_acid.png
tap ARP
tap ARP
tap ARP
tap ARP
tap ARP
expect view 14
wait 600
shot imp_pluck.png
tap SEQ
wait 600
shot imp_drums.png
tap SEQ
tap SEQ
tap SEQ
tap SEQ
expect view 22
wait 600
shot imp_groove.png
turn SELECT 4 100
expect view 26
wait 300
shot imp_space.png
turn SELECT 3 100
expect view 29
wait 300
shot imp_mixer.png
tap FX
wait 300
shot imp_fx.png
tap FX
tap HOME
wait 300
shot imp_perform.png
# the colour variations: Synth, Acid, Ice, Ember, Phosphor
tap GLO
spin K2 1
wait 100
expect theme 1
tap HOME
wait 1600
shot theme_synth.png
tap GLO
spin K2 1
wait 100
tap HOME
wait 600
shot theme_acid.png
tap GLO
spin K2 1
wait 100
tap HOME
wait 600
shot theme_ice.png
tap GLO
spin K2 1
wait 100
tap HOME
wait 600
shot theme_ember.png
tap GLO
spin K2 1
wait 100
expect theme 5
tap HOME
wait 600
shot theme_phosphor.png
# SEL held on a voice page: the footer hint
tap ENV
press SEL
wait 300
shot imp_hint.png
release SEL
