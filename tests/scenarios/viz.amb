# The visualizers: HOME twice quickly; the SELECT dial chooses; the knobs stay the FX knobs, ALGORITHM the mood; HOME leaves.
seed 0
wait 3000
tap HOME
wait 100
tap HOME
wait 100
expect view 29
shot viz_plasma.png
# the knobs are the FX knobs (the filter), ALGORITHM the mood
spin K1 10
wait 100
expect fxk0 10
turn ALGO 5
wait 100
expect mood 60
spin SELECT 1
wait 1500
expect view 29
shot viz_kaleido.png
spin SELECT 1
wait 1500
expect view 29
shot viz_bars.png
spin SELECT 1
wait 1500
expect view 29
shot viz_flux.png
spin SELECT 1
wait 1500
expect view 29
shot viz_disco.png
spin SELECT 1
wait 1500
expect view 29
shot viz_life.png
spin SELECT 1
wait 1500
expect view 29
shot viz_orbit.png
spin SELECT 1
wait 1500
expect view 29
shot viz_auto.png
spin SELECT 1
wait 300
expect view 29
# HOME leaves them: the perform screen
tap HOME
wait 100
expect view 28