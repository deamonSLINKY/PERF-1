# The visualizers: HOME twice quickly; the SELECT dial chooses; the knobs stay the FX knobs, ALGORITHM the mood; HOME leaves.
seed 0
wait 3000
tap HOME
wait 100
tap HOME
wait 100
expect view 36
shot viz_plasma.png
# the knobs are the FX knobs (the filter), ALGORITHM the mood
spin K1 10
wait 100
expect fxk0 10
turn ALGO 5
wait 100
expect mood 60
spin SELECT 1
wait 1500
expect view 36
shot viz_kaleido.png
spin SELECT 1
wait 1500
expect view 36
shot viz_bars.png
spin SELECT 1
wait 1500
expect view 36
shot viz_flux.png
spin SELECT 1
wait 1500
expect view 36
shot viz_disco.png
spin SELECT 1
wait 1500
expect view 36
shot viz_life.png
spin SELECT 1
wait 1500
expect view 36
shot viz_orbit.png
# TRIP (0.16.10): the kaleidoscope tunnel
spin SELECT 1
wait 1500
expect view 36
expect viz 7
shot viz_trip.png
# THEORY (0.16.10): the circle of fifths, the chord's degree, name and notes, the progression
spin SELECT 1
wait 1500
expect view 36
expect viz 8
shot viz_theory.png
spin SELECT 1
wait 1500
expect view 36
expect viz 9
shot viz_auto.png
spin SELECT 1
wait 300
expect view 36
# HOME leaves them: the perform screen
tap HOME
wait 100
expect view 35
# THEORY is remembered through a power cycle (its 7 in the settings plus a bit in the spare byte; AUTO stays AUTO)
tap HOME
wait 100
tap HOME
wait 100
expect view 36
spin SELECT -1
wait 300
spin SELECT -1
wait 300
expect viz 8
tap PLAY
wait 4000
reboot
wait 3000
expect viz 8
# and TRIP
tap HOME
wait 100
tap HOME
wait 100
expect view 36
spin SELECT -1
wait 300
expect viz 7
tap PLAY
wait 4000
reboot
wait 3000
expect viz 7
