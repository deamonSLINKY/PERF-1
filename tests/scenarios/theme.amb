# the theme (and Tune, MIDI out) stick across a power cycle even if the music never stops: written
# two seconds after the last change. A piece stored while playing still waits for the stop.
wait 500
expect playing 1
tap GLO
spin K2 2
expect theme 2
expect dirty 1
wait 1000
expect store_writes 0
wait 1500
expect dirty 0
expect store_writes 1
reboot
wait 300
expect theme 2
# a piece stored while playing, then a theme: the theme is written, the piece waits
tap ENV
spin K1 -10
tap GLO
tap SAVE
expect saved 1
spin K2 1
expect theme 3
wait 2500
expect store_writes 2
expect dirty 1
reboot
wait 300
expect theme 3
expect saved 0
expect par0 45
