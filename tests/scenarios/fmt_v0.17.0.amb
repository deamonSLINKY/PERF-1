# The save formats (tools/format_fixture.sh): what release v0.17.0 saved (tests/format/v0.17.0/) loads in this build as it did when the fixture
# was made (tests/format/v0.17.0/state.txt; a line this build adds is fine, a line that changed is not).
seed 0
wait 500
loadobj 0 tests/format/v0.17.0/o0.bin
loadobj 22 tests/format/v0.17.0/o22.bin
loadobj 23 tests/format/v0.17.0/o23.bin
loadobj 4 tests/format/v0.17.0/o4.bin
loadobj 6 tests/format/v0.17.0/o6.bin
reboot
wait 3000
fmtcheck tests/format/v0.17.0/state.txt
