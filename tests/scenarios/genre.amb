# round to the first again; its piece 1 as it was
press GLO
turn PRESET 1
release GLO
wait 300
expect genre 0
expect fxlock 0
expect piece 1
# the first bank keeps its session changes while you are in the others: its tempo changed, away and back
tap GLO
tap HOME
wait 100
spin K1 3
wait 100
expect tempo 127
press GLO
turn PRESET 1
release GLO
wait 200
expect genre 1
press GLO
turn PRESET -1
release GLO
wait 300
expect genre 0
expect tempo 127
# the others come back as their recipes: lofi piece 1, its tempo changed, away and back: 78 again
press GLO
turn PRESET 1
release GLO
wait 200
tap GLO
tap HOME
wait 100
spin K1 3
wait 100
expect tempo 81
press GLO
turn PRESET 1
release GLO
wait 200
press GLO
turn PRESET -1
release GLO
wait 300
