# the voice bank: SEL + ALGORITHM changes the sound of the voice on screen (pad, drone, acid; on the drums'
# pages the whole kit); each voice's Sound knob; the Kit page (SEQ three times), a sound for each drum.
# Keys on a voice's pages play it (the scale stays as it is); on any other page they edit the scale.
wait 500
expect par10 1
# the pad: SEL + ALGORITHM, then its Sound knob (KNOB 3)
tap ENV
press SEL
turn ALGO 1
release SEL
expect par10 2
expect edited 1
turn K3 1
expect par10 3
wait 1500
shot sound_pad.png
# the drone: round past the first to the last; its Sound knob is KNOB 2
tap LFO
press SEL
turn ALGO -1
release SEL
expect par84 7
turn K2 -3
expect par84 4
wait 1500
shot sound_drone.png
# the acid: its Sound is KNOB 4 on Acid env
tap ARP
tap ARP
expect view 9
turn K4 2
expect par40 2
# the kit: SEQ three times; one drum, then all four at once with SEL + ALGORITHM
tap SEQ
tap SEQ
tap SEQ
expect view 13
turn K1 1
expect par85 1
expect par86 0
press SEL
turn ALGO 2
release SEL
expect par85 3
expect par86 3
expect par87 3
expect par88 3
wait 1500
shot kit.png
# a page with no voice: nothing changes
tap HOME
press SEL
turn ALGO 1
release SEL
expect par10 3
expect par84 4
# keys on a voice's page play it, the scale untouched; let go, the note's gone
tap LFO
key w2 down
wait 300
expect held 1
expect pool 0x5AD
shot playing_drone.png
key w2 up
wait 100
expect held 0
# two keys on the pad: two of its voices
tap ENV
key w0 down
key w4 down
wait 400
expect held 2
key w0 up
key w4 up
wait 100
expect held 0
expect pool 0x5AD
# the acid, played while stopped: it sounds
tap ARP
tap PLAY
wait 600
expect playing 0
peakreset
key w7 down
wait 400
expect held 1
expect peak_db_max -0.5
expect peak_db_min -40
key w7 up
# a key let go after the page changed still lets go of its note
key w9 down
wait 100
tap HOME
key w9 up
wait 100
expect held 0
# on Tempo the keys edit the scale, as ever
tapkey w1
wait 50
expect held 0
expect pool 0x1AD
