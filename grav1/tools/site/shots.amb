# GRAV-1's renders: the simulator's screens and lights (tools/site/mockups.py runs this). 'echo @name' then
# 'leds' names the lights that go with a shot.
splash 3200
reboot
wait 900
shot splash.png
wait 1500
shot splash_grav.png
wait 1200
wait 14000
tap HOME
wait 400
shot system.png
echo @system
leds
tap ENV
wait 400
shot star.png
echo @star
leds
tap ARP
turn SELECT 2
wait 400
shot planet.png
echo @planet
leds
tap LFO
wait 400
shot gravity.png
echo @gravity
leds
tap LFO
wait 400
shot weather.png
echo @weather
leds
tap SEQ
tapkey b2
wait 2500
