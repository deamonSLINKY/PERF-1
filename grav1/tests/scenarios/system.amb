# GRAV-1: the system plays; the pages; the Pulse on the keys; the weather on the keys; eclipse; the Great
# Year; saving on Setup and coming back after a reboot; another system; resting
wav sol.wav
wait 4000
shot boot.png
wait 30000
expect playing 1
expect notes >5
expect hits >20
shot sol.png
wavstop
# the star: its level on KNOB 1
tap ENV
expect view 1
spin K1 -20
expect par4 35
shot star.png
# the planets: SELECT walks them one by one
tap ARP
expect view 2
expect sel 0
turn SELECT 1
expect view 2
expect sel 1
spin K2 2
expect par13 3
tap OCT+
expect par15 1
wait 2000
shot planet.png
# the Pulse: black keys pick the lane, white keys its steps
tap SEQ
expect view 5
tapkey b2
expect lane 2
tapkey w4
expect par51 17
wait 3000
shot pulse.png
# the sequencer: SEQ held; SELECT the bank (it plays from the next bar), OCT and black keys the lane
press SEQ
wait 800
release SEQ
expect view 10
turn SELECT 1
expect par42 1
tap OCT+
expect lane 3
tapkey b5
expect lane 5
tapkey w1
expect par60 21847
wait 6000
expect bank 1
shot seq.png
turn SELECT -1
wait 6000
expect bank 0
tap SEQ
expect view 5
# the weather: black keys 1-3 call it
tap LFO
expect view 3
tap LFO
expect view 4
tapkey b1
wait 500
expect rock 1
tapkey b2
wait 500
expect comet 1
tapkey b0
wait 15000
expect dust >20
shot weather.png
# eclipse
tap REC
wait 1000
expect frozen 1
shot eclipse.png
tap REC
wait 500
expect frozen 0
# EDIT: the Great Year now
tap EDIT
wait 300
expect greats >0
# the screen's theme (global), then saving on Setup
tap GLO
expect view 7
tap GLO
expect view 8
spin K1 2
expect par107 2
wait 300
shot display.png
tap GLO
expect view 9
tap SAVE
wait 300
expect dirty 0
expect store_writes >0
reboot
wait 500
expect par4 35
expect par13 3
expect par107 2
# SAVE away from Setup starts the system again (nothing saved)
tap HOME
tap SAVE
wait 500
expect dirty 0
# a minute untouched on the System page: the orbit view, the lights playing; a key only wakes it
tap HOME
wait 61000
expect full 1
shot full.png
leds
tapkey w3
wait 300
expect full 0
expect pool 0x6AD
# another system
turn PRESET 3
wait 4000
expect piece 3
shot ember.png
# resting: quiet in the end
tap PLAY
wait 8000
expect playing 0
peakreset
wait 25000
expect peak_db_max -36
