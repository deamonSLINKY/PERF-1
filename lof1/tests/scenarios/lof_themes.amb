# LOF-1's looks: Global 2 (GLO five times): Theme, CRT, Tune, Lights; SAVE there stores them alone, and they
# come back after a restart
wait 3000
tap GLO
tap GLO
tap GLO
tap GLO
tap GLO
wait 300
expect view 15
shot g2.png
turn K1 1
wait 400
shot theme1.png
turn K1 1
wait 400
shot theme2.png
turn K1 1
wait 400
shot theme3.png
turn K1 1
wait 400
shot theme4.png
turn K2 -1
wait 400
shot crt_off.png
expect dirty 1
tap SAVE
wait 300
expect store_writes 1
reboot
wait 3000
tap GLO
tap GLO
tap GLO
tap GLO
tap GLO
wait 400
shot after_reboot.png
