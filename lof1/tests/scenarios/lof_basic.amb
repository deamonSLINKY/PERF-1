# LOF-1: the band on its own, then a melody on the keys, the pages, Side B, hold
wav basic.wav
wait 9000
expect playing 1
expect auto 1
expect hits >40
expect changes >2
shot groove.png
# a melody in D dorian: D F A C (keys: F3 = 0, so D4 = 9, F4 = 12, A4 = 16, C5 = 19)
key 9 down
wait 300
key 9 up
key 12 down
wait 300
key 12 up
key 16 down
wait 300
key 16 up
key 19 down
wait 600
key 19 up
wait 300
# a held chord: G B D (key G3 = 2, B3 = 6, D4 = 9) + F (12)
key 2 down
key 6 down
key 9 down
key 12 down
wait 2400
expect auto 0
shot groove_follow.png
key 2 up
key 6 up
key 9 up
key 12 up
wait 2600
expect notes >7
tap ENV
wait 200
shot lead.png
tap LFO
wait 200
shot comp.png
tap EDIT
wait 200
shot bass.png
tap ARP
wait 1500
shot answer.png
tap SEQ
wait 200
shot drums.png
tap GLO
wait 200
shot dust.png
tap GLO
tap GLO
tap GLO
wait 200
shot global.png
tap HOME
tap SAVE
wait 5000
expect sideb 2
tap SAVE
wait 6000
expect sideb 0
tap REC
wait 2000
expect held 1
tap REC
wavstop
expect peak_db_max -0.1
expect peak_db_min -30
