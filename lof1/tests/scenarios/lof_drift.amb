# Groove 2: Drift changes the drums every 4 bars (Random from patterns 1-8); SEL + SEQ asks for a change now
wav drift.wav
expect par30 0
tap HOME
expect view 1
spin K1 -2
expect par66 1
spin K2 2
expect par67 2
spin K3 4
expect par68 8
shot groove2.png
wait 14500
expect par30 >0
shot groove2_later.png
# Drift off: the pattern stays; a manual change still comes
spin K1 -1
expect par66 0
spin K2 -1
expect par67 1
wait 3500
press SEL
tap SEQ
release SEL
wait 3500
expect par30 >-1
wavstop
expect peak_db_max -0.05
