# LOF-1: the Global page's keys set the scale (AMB-1's way), SAVE there stores the preset (never Side B),
# and a store while playing hushes the music around the write
wait 2000
tap GLO
tap GLO
tap GLO
tap GLO
wait 300
expect view 14
# preset 01 is D Dorian (D E F G A B C): take B out (key 6 = B3), the scale becomes your own
tapkey 6
wait 200
expect par70 >0
shot scale_custom.png
# put B back: Dorian again, by name
tapkey 6
wait 200
expect par70 0
expect par49 2
# take F out and put Eb in (F3 = key 0, Eb4 = key 10): a scale of your own
tapkey 0
tapkey 10
wait 200
expect par70 >0
# the band plays on in it
wait 4000
expect playing 1
# SAVE on Global stores the preset, with the scale, and Side B stays off
tap SAVE
wait 1500
expect store_writes 1
expect sideb 0
expect playing 1
# reboot: the scale of your own comes back
reboot
wait 1500
expect par70 >0
# turning Scale: back to the named ones
tap GLO
tap GLO
tap GLO
tap GLO
turn K2 1
wait 200
expect par70 0
