# every tape plays; the answer answers; Daydream dreams; the effects don't break anything
wav tapes.wav
wait 4000
tap ARP
spin K3 50
wait 300
# a phrase, then rest: the answer should come
tapkey 9
wait 250
tapkey 12
wait 250
tapkey 16
wait 250
tapkey 14
wait 4000
expect answers >0
turn PRESET 1
wait 6000
shot tape2.png
turn PRESET 1
wait 6000
shot tape3.png
turn PRESET 1
wait 6000
turn PRESET 1
wait 6000
shot tape5.png
turn PRESET 1
wait 6000
shot tape6.png
turn PRESET 1
wait 6000
shot tape7.png
turn PRESET 1
wait 12000
expect piece 7
expect dreaming 1
expect dream_notes >3
shot tape8.png
# effects: FX on, hold stutter, tape stop, backspin, muffle, mute drums
tap FX
expect fx 1
key w0 down
wait 1200
key w0 up
key w4 down
wait 1200
key w4 up
key w5 down
wait 900
key w5 up
key w6 down
wait 1500
key w6 up
key w12 down
key b1 down
wait 1500
key w12 up
key b1 up
tap FX
wait 2000
# the sequencer: hold SEQ, toggle a step, leave
press SEQ
wait 800
release SEQ
expect seq 1
tapkey w3
shot seq.png
tap SEQ
expect seq 0
wavstop
expect peak_db_max -0.05
expect peak_db_min -30
