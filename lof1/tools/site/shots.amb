# LOF-1's renders: the simulator's screens and lights (tools/site/mockups.py uses them). 'echo @name' then
# 'leds' names the lights that go with a shot.
splash 3200
reboot
wait 900
shot splash.png
wait 1500
shot splash_lof.png
wait 1200
# the band on its own for a while, then a few notes so it follows
wait 6000
shot groove.png
echo @groove
leds
tapkey 9
wait 250
tapkey 12
wait 250
key 16 down
wait 900
shot playing.png
echo @playing
leds
key 16 up
wait 1500
tap HOME
wait 300
shot groove2.png
tap HOME
tap ENV
wait 300
shot lead.png
echo @lead
leds
tap ENV
wait 300
shot daydream.png
tap ENV
wait 300
shot daydream2.png
tap LFO
wait 300
shot comp.png
tap LFO
wait 300
shot compstyle.png
tap EDIT
wait 300
shot bass.png
tap ARP
wait 300
shot answer.png
tap SEQ
wait 300
shot drums.png
echo @drums
leds
tap SEQ
wait 300
shot kit.png
press SEQ
wait 800
release SEQ
wait 300
shot seq.png
echo @seq
leds
tap SEQ
wait 1500
tap GLO
wait 300
shot dust.png
tap GLO
wait 300
shot dust2.png
tap GLO
wait 300
shot space.png
tap GLO
wait 300
shot global.png
tap HOME
wait 300
press REC
wait 1300
shot help.png
release REC
wait 300
# chords on the keys
press SEL
tap HOME
release SEL
wait 300
key 9 down
wait 1200
shot chords.png
echo @chords
leds
key 9 up
press SEL
tap HOME
release SEL
wait 300
# FX: the key map, a held effect, locks
tap FX
wait 300
shot fx.png
echo @fx
leds
key w6 down
wait 600
shot fx_muffle.png
key w6 up
press SAVE
wait 200
tapkey w4
tapkey b1
release SAVE
wait 400
shot fx_lock.png
press SEL
tap FX
release SEL
tap FX
wait 300
# the other tapes: cassette, reel, radio
turn PRESET 1
wait 6000
shot tape2.png
echo @tape2
leds
turn PRESET 2
wait 6000
shot tape4.png
turn PRESET 2
wait 6000
shot tape6.png
echo @tape6
leds
turn PRESET 2
wait 12000
shot dreaming.png
# the screensaver, nodding
saver 4000
wait 5000
shot saver.png
echo @saver
leds
wait 260
shot saver_nod.png
